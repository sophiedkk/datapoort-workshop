definition
	ADMIN_ENTRY[at0000] matches {    -- Inpatient admission details
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- Mode of access
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0007,    -- Ambulatory
									at0008,    -- Wheelchair
									at0009]    -- Stretcher
								}
							}
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0010] occurrences matches {0..*} matches {    -- Transported with
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0011,    -- Oxygen
									at0012,    -- Monitor
									at0013]    -- IV
								}
							}
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0015] occurrences matches {0..1} matches {    -- Admission method
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0016,    -- Waiting list
									at0017,    -- Booked
									at0018,    -- Planned
									at0019,    -- A&E department
									at0020,    -- General Practitioner
									at0021,    -- Bed Bureau
									at0022,    -- Consultant Clinic
									at0026]    -- Other
								}
							}
						}
					}
					ELEMENT[at0023] occurrences matches {0..1} matches {    -- Additional Help needed
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0024,    -- Yes
									at0025]    -- No
								}
							}
							DV_BOOLEAN matches {*}
						}
					}
				}
			}
		}
	}

